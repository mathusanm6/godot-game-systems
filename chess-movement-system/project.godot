config_version=5

[application]

config/name="chess-movement-system"
run/main_scene="uid://u5csj2kfedvn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
Cursor="*uid://djwpw33d4d8u7"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[editor]

movie_writer/movie_file="/Users/mathusanm6/Godot/godot-game-systems/chess-movement-system/movie/movie.avi"
movie_writer/disable_vsync=true

[editor_plugins]

enabled=PackedStringArray("res://addons/awesome_custom_cursor/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

